{
  "manifest_version": 3,
  "name": "Krillion Solver",
  "version": "1.0.0",
  "description": "Reads the prompt on Krillion (daily dive and Puffer Party) and lists every answer by tier, minus the ones already said.",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://krillion.io/*",
    "https://*.krillion.io/*",
    "https://krillion.run/data/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "sw.js" },
  "action": {
    "default_title": "Krillion Solver",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    {
      "matches": ["https://krillion.io/*", "https://*.krillion.io/*"],
      "js": ["match.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
